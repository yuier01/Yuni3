      "buildIn": true,
      "plugins": [
        {
          "id": "BilibiliVideoParser",
          "name": "B 站视频解析",
          "version": "0.0.1",
          "description": "识别 BV 号或 b23.tv 短链接并展示视频基本信息",
          "tips": [
            "检测到聊天消息中包含 BV 号或 b23.tv 短链接，自动解析视频相关信息",
