      "plugins": [
        {
          "id": "AntiGbf",
          "name": "骑空士陷阱粉碎机",
          "version": "0.0.1",
          "description": "警惕骑空士的陷阱",
          "tips": [
            "检测到消息中含有 `granbluefantasy.jp` 文本，自动警告骑空士的陷阱"
          ],
          "author": "Yuier me@yuier.com"
        }
      ]
    },
    {
      "id": "yizhi",
      "repo": "yuier01/Yuni3-plugin-repo",
      "module": "yizhi",
      "description": "要我一直 IMAGE 吗",
      "author": "Yuier me@yuier.com",
      "type": "builtin",
      "plugins": [
        {
          "id": "YaoWoYiZhi",
          "name": "要我一直 IMAGE 吗",
          "version": "0.0.1",
          "description": "一直.image",
          "tips": [
            "向群聊发送 `/一直 {图片}` ，bot 会向群聊发送一张 “<大图> 要我一直<小图>吗” 的图片"
          ],
          "author": "Yuier me@yuier.com"
        }
      ]
    },
    {
      "id": "example",
      "repo": "yuier01/Yuni3-plugin-repo",
      "module": "example",
      "description": "示例模块",
      "author": "Yuier me@yuier.com",
      "type": "builtin",
      "plugins": [
        {
          "id": "schedule.OhaYo",
          "name": "定时插件示例",
          "version": "0.0.1",
          "description": "定时任务插件示例",
          "tips": [
            "每天早上会向 bot master 问好。"
          ],
          "author": "Yuier me@yuier.com"
        },
        {
          "id": "command.HelloCommand",
          "name": "指令插件示例",
          "version": "0.0.1",
          "description": "验证指令系统可用性",
          "tips": [
            "在群聊内发送“/test”，bot 会响应 “Hello Command!”"
          ],
          "author": "Yuier me@yuier.com"
        },
        {
          "id": "pattern.HelloPattern",
          "name": "规则插件示例",
          "version": "0.0.1",
          "description": "验证模式匹配可用性",
          "tips": [
            "在群聊内发送带有“你好”的消息，bot 会响应 “你好，我是 {bot 昵称} !”"
          ],
          "author": "Yuier me@yuier.com"
        },
        {
          "id": "immediate.IAmBack",
          "name": "即时插件示例",
          "version": "0.0.1",
          "description": "即时任务插件实例",
          "tips": [
            "启动后会向特定群聊发送一条消息“我是后背”"
          ],
          "author": "Yuier me@yuier.com"
        }
      ]
    },
    {
      "id": "steam",
      "repo": "yuier01/Yuni3-plugin-repo",
      "module": "steam",
      "description": "Steam 游戏状态监控",
      "author": "Yuier me@yuier.com",
      "type": "builtin",
      "buildIn": true,
      "plugins": [
        {
          "id": "Steam",
          "name": "Steam 状态监控与绑定",
          "version": "0.0.1",
          "description": "监控群友的 steam 游戏状态，并提供绑定/解绑命令",
          "tips": [
            "群友绑定 steam id 后，其开始/停止/更换游戏时 bot 会在群内播报",
            "使用 `/steam 绑定id {steam id}` 绑定",
            "使用 `/steam 解绑id` 解绑"
          ],
          "author": "Yuier me@yuier.com"
        }
      ]
    },
    {
      "id": "mcmanage",
      "repo": "yuier01/Yuni3-plugin-repo",
