    {
      "id": "setu",
      "repo": "yuier01/Yuni3-plugin-repo",
      "module": "setu",
      "description": "色图模块",
      "author": "Yuier me@yuier.com",
      "type": "builtin",
      "plugins": [
        {
          "id": "Setu",
          "name": "涩涩",
          "version": "0.0.1",
          "description": "群友喜闻乐见的模块",
          "tips": [
            "向群聊发送 `/色图` ，bot 会向群聊发送一张色图",
            "图片资源来自网络，如果群友觉得不够涩那也没办法了 (￣▽￣)"
          ],
          "author": "Yuier me@yuier.com"
        }
      ]
