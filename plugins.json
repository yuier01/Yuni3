{
  "version": 1,
  "packages": [
    {
      "id": "maimai",
      "repo": "yuier01/Yuni3-plugin-repo",
      "module": "maimai",
      "description": "麦麦 AI 聊天适配器",
      "author": "Yuier me@yuier.com",
      "type": "builtin",
      "plugins": [
        {
          "id": "maimai.MaiMaiAdapterBooter",
          "name": "maimai-连接器",
          "version": "0.0.1",
          "description": "启动 WebSocket 服务器，接受 MaiBot-Napcat-Adapter 连接，实现 OneBot 协议核心动作",
          "tips": [
            "NapCat ←→ Yuni ←→ maimai 双向中转"
          ],
          "author": "Yuier me@yuier.com"
        },
        {
          "id": "maimai.OneBotMessageForward",
          "name": "maimai-消息转发",
          "version": "0.0.1",
          "description": "将 QQ 群聊/私聊消息（非命令）转发给 maimai",
          "tips": [
            "不转发命令消息，maimai 专注于群聊自然对话"
          ],
          "author": "Yuier me@yuier.com"
        }
      ]
    },
    {
      "id": "fortune",
      "repo": "yuier01/Yuni3-plugin-repo",
      "module": "fortune",
      "description": "每日运势",
      "author": "Yuier me@yuier.com",
      "type": "builtin",
      "plugins": [
        {
          "id": "Fortune",
          "name": "今日运势",
          "version": "0.0.1",
          "description": "少女祈祷中……",
          "tips": [
            "向群聊发送 `/运势` ，查看自己今天的运势",
            "一天内重复查看，运势不变"
          ],
          "author": "Yuier me@yuier.com"
        }
      ]
    },
    {
      "id": "plugin-manage",
      "repo": "yuier01/Yuni3-plugin-repo",
      "module": "buildin/plugin-manage",
      "description": "插件管理模块",
      "author": "Yuier me@yuier.com",
      "type": "builtin",
      "buildIn": true,
      "plugins": [
        {
          "id": "PluginManage",
          "name": "插件管理入口",
          "version": "0.0.1",
          "description": "插件管理命令的入口",
          "tips": [
            "向群聊发送 “/插件 查看” 可以查看当前群聊下插件列表",
            "向群聊发送 “/插件 查看 {插件序号}” 可以查看对应插件详情",
            "向群聊发送 “/插件 开启 {插件序号}” 可以启用对应插件",
            "向群聊发送 “/插件 关闭 {插件序号}” 可以禁用对应插件",
            "向群聊发送 “/插件 重载 {插件序号}” 可以重载对应插件",
            "向群聊发送 “/插件 重载” 可以重载全部插件"
          ],
          "author": "Yuier me@yuier.com"
        }
      ]
    },
    {
      "id": "event-manage",
      "repo": "yuier01/Yuni3-plugin-repo",
      "module": "buildin/eventmanage",
      "description": "通用事件处理模块",
      "author": "Yuier me@yuier.com",
      "type": "builtin",
      "buildIn": true,
      "plugins": [
        {
          "id": "notice.PokeNotice",
          "name": "戳一戳事件处理",
          "version": "0.0.1",
          "description": "戳一戳事件处理",
          "tips": [
            "戳一戳 bot ，bot 会回复"
          ],
          "author": "Yuier me@yuier.com"
        },
        {
          "id": "meta.HeartBeatEvent",
          "name": "OneBot 心跳事件处理",
          "version": "0.0.1",
          "description": "OneBot 心跳事件处理",
          "tips": [
            "接收心跳事件，简单打印一下"
          ],
          "author": "Yuier me@yuier.com"
        }
      ]
    },
    {
      "id": "help",
      "repo": "yuier01/Yuni3-plugin-repo",
      "module": "buildin/help",
      "description": "帮助信息模块",
      "author": "Yuier me@yuier.com",
      "type": "builtin",
      "buildIn": true,
      "plugins": [
        {
          "id": "HelpInfo",
          "name": "帮助信息",
          "version": "0.0.1",
          "description": "输出帮助信息",
          "tips": [
            "向群聊发送 “/帮助” 可以查看帮助信息"
          ],
          "author": "Yuier me@yuier.com"
        }
      ]
    },
