      "description": "MC 服务器管理",
      "author": "Yuier me@yuier.com",
      "type": "builtin",
      "buildIn": true,
      "plugins": [
        {
          "id": "MCManage",
          "name": "MC 服务管理",
          "version": "0.0.1",
          "description": "MC 服务器管理",
          "tips": [
            "使用 `/mc` 查询本群服务器状态",
            "使用 `/mc 添加 {名称} {地址}` 添加服务器",
            "使用 `/mc 删除 {名称}` 删除服务器"
          ],
          "author": "Yuier me@yuier.com"
        }
      ]
    },
    {
      "id": "guess-number",
      "repo": "yuier01/Yuni3-plugin-repo",
      "module": "guess-number",
      "description": "长会话猜数字示例",
      "author": "Yuier me@yuier.com",
      "type": "builtin",
      "plugins": [
        {
          "id": "GuessNumber",
          "name": "猜数字（长会话示例）",
          "version": "0.0.1",
          "description": "多轮猜数字：初始只有发起者，其他人通过独有加入指令参与",
          "tips": [
            "在群聊发送 `/猜数字` 创建游戏，默认范围 1~100",
            "发送 `/猜数字 <left> <right>` 可自定义范围，例如 `/猜数字 1 1000`",
            "其他人发送 `/加入 猜数字` 参与，发送 `/退出 猜数字` 离开",
            "参与者直接发送范围内的整数猜数；猜中后游戏结束"
          ],
          "author": "Yuier me@yuier.com"
        }
      ]
    },
    {
      "id": "bilibili",
      "repo": "yuier01/Yuni3-plugin-repo",
