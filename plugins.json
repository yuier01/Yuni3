          "tips": [],
          "author": "Yuier me@yuier.com"
        },
        {
          "id": "StartAtThursday",
          "name": "疯狂星期四-重启适配",
          "version": "0.0.1",
          "description": "适配在周四重启时的情况",
          "tips": [],
          "author": "Yuier me@yuier.com"
        }
      ]
    },
    {
      "id": "daily-news",
      "repo": "yuier01/Yuni3-plugin-repo",
      "module": "daily-news",
      "description": "每日早报",
      "author": "Yuier me@yuier.com",
      "type": "builtin",
      "plugins": [
        {
          "id": "DailyNews",
          "name": "每日早报",
          "version": "0.0.1",
          "description": "每天定时发送早报",
          "tips": [],
          "author": "Yuier me@yuier.com"
        }
      ]
    },
    {
      "id": "chieru",
      "repo": "yuier01/Yuni3-plugin-repo",
      "module": "chieru",
      "description": "切噜语 / 齁哦语转换",
      "author": "Yuier me@yuier.com",
      "type": "builtin",
      "plugins": [
        {
          "id": "ChieruTrans",
          "name": "切噜语转换",
          "version": "0.0.1",
          "description": "切噜语转换",
          "tips": [
            "向群聊发送 “/切噜 转换 {文本}” 可以将文本转换为切噜语",
            "向群聊发送 “/切噜 还原 {切噜语文本} 可以将切噜语还原为原始文本”"
          ],
          "author": "Yuier me@yuier.com"
        },
        {
          "id": "HooTrans",
          "name": "齁哦语转换",
          "version": "0.0.1",
          "description": "齁哦语转换",
          "tips": [
            "向群聊发送 “/齁哦 转换 {文本}” 可以将文本转换为齁哦语",
            "向群聊发送 “/齁哦 还原 {切噜语文本} 可以将齁哦语还原为原始文本”"
          ],
          "author": "Yuier me@yuier.com"
        }
      ]
    },
    {
      "id": "pig-today",
      "repo": "yuier01/Yuni3-plugin-repo",
      "module": "pig-today",
      "description": "今日猪猪",
      "author": "Yuier me@yuier.com",
      "type": "builtin",
      "plugins": [
        {
          "id": "PigToday",
          "name": "今日猪猪",
          "version": "0.0.1",
          "description": "今天你是什么猪？",
          "tips": [
            "向群聊发送 `/今日猪猪` ，查看自己今天是什么猪",
            "向群聊发送 `/今日猪猪 {@someone}` ，查看群友今天是什么猪",
            "一天内重复查看，猪设不变"
          ],
          "author": "Yuier me@yuier.com"
        }
      ]
